@using UniversityExplorer.Models

<div class="card shadow-sm mt-4">

    <div class="card-header">
        <h4>University Details</h4>
    </div>

    <div class="card-body">

        <h5>@University.UniversityName</h5>

        <p>
            <strong>Country:</strong>
            @University.Country
        </p>

        <p>
            <strong>Website:</strong>

            <a href="@University.Website"
               target="_blank"
               rel="noopener noreferrer">
                @University.Website
            </a>
        </p>

        <p>
            <strong>Domain:</strong>
            @University.Domain
        </p>

    </div>
</div>

@code {
    [Parameter]
    public University University { get; set; } = new();
}