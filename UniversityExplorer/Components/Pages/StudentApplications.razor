@page "/student-applications"

@using UniversityExplorer.Models
@using UniversityExplorer.Services

@inject StudentApplicationService ApplicationService

<PageTitle>Student Applications</PageTitle>

<div class="container mt-4">

    <h1>Student Applications</h1>

    <p>View and manage student applications.</p>

    <a href="/student-applications/create"
       class="btn btn-primary mb-3">
        Create New Application
    </a>

    @if (isLoading)
    {
        <p>Loading applications...</p>
    }
    else if (hasError)
    {
        <div class="alert alert-danger">
            Unable to retrieve student applications.
        </div>
    }
    else
    {
        <p>Applications found: @applications.Count</p>

        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Student Name</th>
                    <th>University</th>
                    <th>Country</th>
                    <th>Course</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var application in applications)
                {
                    <tr>
                        <td>@application.Id</td>

                        <td>@application.StudentName</td>

                        <td>@application.University</td>

                        <td>@application.Country</td>

                        <td>@application.Course</td>

                        <td>
                            <a class="btn btn-warning btn-sm"
                               href="@($"/student-applications/edit/{application.Id}")">
                                Edit
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>
    }

</div>

@code {

    private List<StudentApplication> applications = new();

    private bool isLoading = true;

    private bool hasError = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            applications =
                await ApplicationService.GetApplicationsAsync();
        }
        catch
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }
}