@page "/"

<PageTitle>University Explorer Portal</PageTitle>

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-4">University Explorer Portal</h1>

        <p class="lead text-muted">
            Explore universities around the world
            and manage student applications.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center p-4">

                    <h3>University Explorer</h3>

                    <p>
                        Discover countries, explore universities
                        and find information about educational institutions.
                    </p>

                    <a href="/university-explorer"
                       class="btn btn-primary">
                        Explore Universities
                    </a>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center p-4">

                    <h3>Student Applications</h3>

                    <p>
                        View, create and update student applications
                        using our application management system.
                    </p>

                    <a href="/student-applications"
                       class="btn btn-success">
                        Manage Applications
                    </a>

                </div>
            </div>
        </div>

    </div>

</div>